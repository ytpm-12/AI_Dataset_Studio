{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DatasetRecommendation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "target",
    "parameters",
    "confidence",
    "explanation",
    "requires_validation"
  ],
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "impute_missing",
        "drop_duplicates",
        "review_duplicates",
        "cast_type",
        "standardize_format",
        "normalize_text",
        "review_outliers",
        "scale_numeric",
        "encode_categorical",
        "flag_class_imbalance",
        "validate_integrity",
        "request_human_review",
        "no_action",
        "reject_unsupported"
      ]
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "parameters": {
      "type": "object"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "explanation": {
      "type": "string",
      "minLength": 1
    },
    "requires_validation": {
      "type": "boolean"
    }
  }
}
